# PriceWatch v1.0 — benchmark credentials (LOCAL ONLY, never commit)
# Copy to .env.foundry and fill in real values, then tell Claude "ready".

# Azure AI Foundry (the 5 Global-Standard deployments). Endpoint MUST end with /openai/v1/
export AZURE_INFERENCE_ENDPOINT="https://<your-resource>.services.ai.azure.com/openai/v1/"
export AZURE_INFERENCE_CREDENTIAL="<your-foundry-api-key>"

# OpenAI (only needed for the full run, which also re-runs the 4 OpenAI models)
export OPENAI_API_KEY="<your-openai-api-key>"
