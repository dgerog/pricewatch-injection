# PriceWatch — local credentials (LOCAL ONLY, never commit)
# Copy to .env.foundry and fill in real values. Every .env* file is gitignored; only this
# key-free template is tracked. Load it with:  set -a; source .env.foundry; set +a

# Azure AI Foundry (the Global-Standard deployments). The endpoint MUST be the OpenAI-compatible one,
# ending with /openai/v1/ — NOT the project endpoint (…/api/projects/<name>), which answers
# "Missing required query parameter: api-version".
export AZURE_INFERENCE_ENDPOINT="https://<your-resource>.services.ai.azure.com/openai/v1/"
export AZURE_INFERENCE_CREDENTIAL="<your-foundry-api-key>"

# OpenAI (the OpenAI agent models, and the firewall's judge in the demo and the firewall benchmark)
export OPENAI_API_KEY="<your-openai-api-key>"

