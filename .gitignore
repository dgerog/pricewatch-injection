# local python env (create with: python3.12 -m venv agent/.venv)
.venv/
__pycache__/
*.pyc
# runtime + local
*.db
*.log
.DS_Store
.pytest_cache/
# local credentials (copy .env.foundry.example -> .env.foundry). Every .env* file is ignored so a
# key can never be committed by accident; only the key-free *.example templates are tracked.
.env
.env.*
!.env.*.example

# firewall-study debug traces: one line per evaluation, large, regenerated by every run
benchmark/firewall/traces.jsonl
